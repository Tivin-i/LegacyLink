#!/bin/sh
# Prevent commits as "cursoragent" / "Cursor Agent" so they don't appear as a separate contributor.
# Use scripts/commit.sh to commit as LegacyLink AI, or set GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL.
set -e
author_name="${GIT_AUTHOR_NAME:-$(git config user.name 2>/dev/null)}"
case "$author_name" in
  cursoragent|Cursor\ Agent)
    echo "error: Commits as 'cursoragent' / 'Cursor Agent' are not allowed."
    echo "Use: scripts/commit.sh (commits as LegacyLink AI)"
    echo "Or set: git config user.name 'Your Name' and user.email 'your@email.com'"
    exit 1
    ;;
esac
exit 0
